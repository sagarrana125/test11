const resourcesList = document.getElementById('resourcesList');
const filterBtns = document.querySelectorAll('.filter-btn');

function renderResources(filter = 'all') {
    if (!resourcesList) return;
    
    const filteredResources = filter === 'all' 
        ? resourcesData 
        : resourcesData.filter(r => r.category === filter);
    
    resourcesList.innerHTML = filteredResources.map(resource => `
        <a href="${resource.url}" target="_blank" class="resource-item" data-category="${resource.category}">
            <div class="resource-item-icon ${resource.category}">
                <i class="${resource.icon}"></i>
            </div>
            <div class="resource-item-content">
                <h4>${resource.title}</h4>
                <p>${resource.description}</p>
            </div>
            <i class="fas fa-arrow-right resource-item-arrow"></i>
        </a>
    `).join('');
}

